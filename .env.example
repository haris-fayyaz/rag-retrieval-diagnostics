# --------------------------
# LLM PROVIDER CONFIGURATION
# --------------------------
# Options: "fake" (default - deterministic, no network, used in tests/CI)
#          "ollama" (real local model via Ollama)
LLM_PROVIDER=fake

# Used only when LLM_PROVIDER=ollama. Install Ollama, then run:
#   ollama run qwen3:1.7b
LLM_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434
# Running via Docker and want to reach Ollama installed on your HOST
# machine (not another container)? Use this instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Reserved for a future hosted API provider (OpenAI/Anthropic/etc).
# Not read by any provider yet - do not commit a real key here.
LLM_API_KEY=

# --------------------------
# AUTHENTICATION & SECURITY
# --------------------------
# Single hardcoded user for this deployment. No signup flow, no user
# database.
APP_USERNAME=testuser

# Generate with:
#   python -c "from app.core.security import hash_password; print(hash_password('yourpassword'))"
#
# IMPORTANT - Docker Compose escaping: this value is loaded via
# compose.yml's `env_file: .env`. Compose interpolates "$word"
# sequences in .env values as variable references before the
# container ever sees them - a real bcrypt hash contains several
# literal "$" characters and WILL get silently corrupted unless every
# "$" is doubled to "$$". The placeholder below shows the escaped
# form; keep that pattern when you paste in your real hash.
# DO NOT commit a real hash to this file.
APP_PASSWORD_HASH=$$2b$$12$$placeholder_bcrypt_hash_here_replace_with_real_hash

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the app falls back to a random per-process secret and logs
# a warning - tokens won't survive a restart. Fine for a quick local
# check, not for anything you restart or run more than once.
JWT_SECRET=dev-only-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ---------
# DATABASE
# ---------
# Only used for local (non-Docker) runs - compose.yml sets its own
# DATABASE_URL explicitly (sqlite:////app/data/app.db) which always
# wins over this value when running via `docker compose up`.
DATABASE_URL=sqlite:///data/app.db

# -----------------------
# RETRIEVAL CONFIGURATION
# -----------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_TOP_K=10
MAX_QUESTION_CHARACTERS=1000
MAX_DOCUMENT_NAME_LENGTH=200
MAX_DOCUMENT_CHARACTERS=100000

# --------------
# RATE LIMITING
# --------------
# Requests per 60-second window.
RATE_LIMIT_AUTH_TOKEN=5
RATE_LIMIT_ANSWER=10
RATE_LIMIT_DOCUMENTS_POST=5
RATE_LIMIT_DEFAULT=60

# ------
#  CORS
# ------
# Comma-separated allowed origins. No wildcard - fails closed, not open.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000