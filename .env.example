# LLM provider configuration for the /answer endpoint.
# Options: "fake" (default - deterministic, no network, used in tests/CI)
#          "ollama" (real local model via Ollama)
LLM_PROVIDER=fake

# Used only when LLM_PROVIDER=ollama. Install Ollama, then run:
#   ollama run qwen3:1.7b
LLM_MODEL=qwen3:1.7b
OLLAMA_BASE_URL=http://localhost:11434

# Reserved for a future hosted API provider (OpenAI/Anthropic/etc).
# Not read by any provider yet - do not commit a real key here.
LLM_API_KEY=


# Chunking configuration (see chunking_service.py). CHUNK_SIZE must be > 0.
# CHUNK_OVERLAP must be >= 0 and < CHUNK_SIZE.
CHUNK_SIZE=800
CHUNK_OVERLAP=100